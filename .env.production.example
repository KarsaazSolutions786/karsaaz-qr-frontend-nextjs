# =============================================================================
# Karsaaz QR Frontend — Production Environment Configuration
# =============================================================================
# Copy this file to .env.production.local and fill in all values.
# All NEXT_PUBLIC_ variables are exposed to the browser — never put secrets here.
# After editing, rebuild with: npm run build
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# The backend URL WITHOUT a trailing slash and WITHOUT /api suffix.
# The app appends /api internally.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://app.yourdomain.com

# -----------------------------------------------------------------------------
# Google OAuth
# Must match the client ID configured in the backend .env and Google Console.
# Restrict to your production domain in Google Console > Credentials.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Google Maps (used for event/business-profile map embeds)
# Restrict to Maps Embed API only, locked to your domain.
# Get key at: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Stripe (publishable key only — the secret key stays on the backend)
# Get from: https://dashboard.stripe.com/apikeys
# Use the LIVE publishable key (pk_live_...), not the test key.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (client-side)
# Get DSN at: https://sentry.io/ > Project Settings > Client Keys
# Enabled automatically when NODE_ENV=production and DSN is set.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# -----------------------------------------------------------------------------
# Analytics (optional — Web Vitals beacon endpoint)
# If set, Core Web Vitals metrics are sent to this URL via navigator.sendBeacon.
# Leave empty to disable.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_URL=

# -----------------------------------------------------------------------------
# Feature Flags
# Set to true/false to enable/disable features in production.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_PASSWORDLESS_AUTH=true
NEXT_PUBLIC_ENABLE_REFERRAL_SYSTEM=true

# -----------------------------------------------------------------------------
# Build Environment
# This is set automatically by Next.js during `npm run build`.
# Do NOT set NODE_ENV manually in .env files.
# -----------------------------------------------------------------------------
# NODE_ENV=production  # Set by Next.js — do not override
