# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_CANONICAL_URL=https://www.karsaazqr.com

# ─── Backend API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend-url.com

# ─── Google OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_PASSWORDLESS_AUTH=true
NEXT_PUBLIC_ENABLE_REFERRAL_SYSTEM=true

# ─── Sentry (Error Monitoring) ────────────────────────────────────────────────
SENTRY_DSN=https://your-key@sentry.io/your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development


# Cloudflare Turnstile (optional — audit F-18)
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=
CLOUDFLARE_SECRET_KEY=


# Company (footer) — set real address in production
NEXT_PUBLIC_COMPANY_ADDRESS_LINE1=
NEXT_PUBLIC_COMPANY_ADDRESS_LINE2=
