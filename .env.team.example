# ─── Team dev: frontend on YOUR laptop, API on host PC ───────────────────────
# Copy to .env and set HOST_IP from the person running the backend (ipconfig).

NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_API_URL=http://HOST_IP:8000

# Example after replacing HOST_IP:
# NEXT_PUBLIC_API_URL=http://192.168.80.1:8000

NEXT_PUBLIC_CANONICAL_URL=https://www.karsaazqr.com
NODE_ENV=development

# Copy other keys from .env.example as needed (Google, Stripe test keys, etc.)
